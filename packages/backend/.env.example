# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nommable
DATABASE_USER=nommable
DATABASE_PASSWORD=nommable_password

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Account Configuration
# These credentials are used to create the system admin account on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# AI Provider API Keys (Optional - users can configure per-account)
# These are fallback/default keys if not configured per-user
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=http://localhost:5173

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Email / SMTP Configuration (Optional - for sending user invitations via email)
# If left blank, invitations will generate direct registration links for manual sharing
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nommable.local

