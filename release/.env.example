# Nommable release deployment — copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- REQUIRED ---
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-random-password
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# MUST be exactly 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-64-hex-characters-00000000000000000000000000000000
ADMIN_USERNAME=admin
# Change after first login
ADMIN_PASSWORD=change-me

# --- OPTIONAL (defaults shown) ---
# CORS_ORIGIN=http://localhost:8765
# FRONTEND_PORT=8765
# BACKEND_PORT=8766
# MAX_FILE_SIZE=5242880
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
